@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One-kernel moe_align_block_size for single-stream decode on Ampere.
+
+Adapted from snailbrainx/inkling-2-mini-sm80 (site/inkling_sm80_moe_align.py, Apache-2.0). Same contract as
+vllm.model_executor.layers.fused_moe.moe_align_block_size with ignore_invalid_experts=True. Used up to
+MAX_ROWS routed rows (8 tokens x top-8), where its output is identical to the compiled op's and it takes
+3-4 us instead of 10 on an RTX 3090 (tools/mb_align.py); larger batches keep the compiled op.
+"""
+import torch
+
+MAX_ROWS = 64
+
+import triton
+import triton.language as tl
+
+_TRITON_MAX = 4096
+
+
+@triton.jit
+def _moe_align_small_kernel(ids_ptr, sorted_ptr, expert_ids_ptr, total_ptr, numel, max_pad, max_blocks,
+                            E: tl.constexpr, EP: tl.constexpr, BS: tl.constexpr, BLOCK: tl.constexpr,
+                            CH: tl.constexpr, NBC: tl.constexpr):
+    i = tl.arange(0, BLOCK)
+    ids = tl.load(ids_ptr + i, mask=i < numel, other=E)
+    key = tl.where((ids >= 0) & (ids < E), ids, E).to(tl.int32)
+    bins = tl.arange(0, EP)
+    counts = tl.histogram(key, EP)
+    padded = tl.where(bins < E, (counts + BS - 1) // BS * BS, 0)
+    pad_end = tl.cumsum(padded, 0)
+    pad_start = pad_end - padded
+    cnt_start = tl.cumsum(counts, 0) - counts
+    total = tl.sum(padded, 0)
+    for c in range(0, max_pad, CH):
+        o = c + tl.arange(0, CH)
+        tl.store(sorted_ptr + o, tl.zeros((CH,), tl.int32) + numel, mask=o < max_pad)
+    tl.debug_barrier()
+    s = tl.sort(key * BLOCK + i)
+    e_s = s // BLOCK
+    dest = tl.gather(pad_start, e_s, 0) + (i - tl.gather(cnt_start, e_s, 0))
+    tl.store(sorted_ptr + dest, s % BLOCK, mask=e_s < E)
+    for c in range(0, max_blocks, NBC):
+        b = c + tl.arange(0, NBC)
+        start = b * BS
+        before = (pad_end[None, :] <= start[:, None]) & (bins[None, :] < E)
+        ex = tl.where(start < total, tl.sum(before.to(tl.int32), 1), 0)
+        tl.store(expert_ids_ptr + b, ex, mask=b < max_blocks)
+    tl.store(total_ptr, total)
+
+
+def moe_align_small(topk_ids: torch.Tensor, block_size: int, num_experts: int):
+    numel = topk_ids.numel()
+    assert 0 < numel <= MAX_ROWS
+    max_pad = numel + num_experts * (block_size - 1)
+    if numel < num_experts:
+        max_pad = min(numel * block_size, max_pad)
+    max_blocks = -(-max_pad // block_size)
+    dev = topk_ids.device
+    sorted_ids = torch.empty((max_pad,), dtype=torch.int32, device=dev)
+    expert_ids = torch.empty((max_blocks,), dtype=torch.int32, device=dev)
+    total = torch.empty((1,), dtype=torch.int32, device=dev)
+    block = max(triton.next_power_of_2(numel), 16)
+    _moe_align_small_kernel[(1,)](
+        topk_ids.reshape(-1), sorted_ids, expert_ids, total, numel, max_pad, max_blocks,
+        E=num_experts, EP=triton.next_power_of_2(num_experts + 1), BS=block_size, BLOCK=block,
+        CH=1024, NBC=32, num_warps=4)
+    return sorted_ids, expert_ids, total
