+# SPDX-License-Identifier: Apache-2.0
+"""Draft length per step from recent acceptance (Ampere port of Inkling 2 Mini).
+
+The DSpark drafter always drafts the configured number of tokens; the scheduler decides how many of them the
+target verifies in the next step (the mechanism of num_speculative_tokens_per_batch_size). A verified token
+costs time whether or not it is accepted. On two RTX 3090s a step that verifies 7 drafts takes 13.0 ms and one
+that verifies 1 takes 10.0 ms. On predictable text 7 pays; on prose, where the second draft survives one time
+in four, it does not, so no fixed count is right for both.
+
+This keeps a running estimate of how often a draft survives to each position and picks, every step, the count
+that maximises expected tokens per millisecond for the measured step cost. Drafts that are not verified are
+dropped, exactly as with the built-in schedule, so the output distribution is unchanged.
+
+Applies to the batch sizes that have a row in the cost table (one request at a time by default); other batch
+sizes keep the count the schedule gives them.
+
+  INKLING_SM86_TUNE          without "adaptive" in the list (or "none") switches this off
+  INKLING_SM86_STEP_MS       JSON {"<batch size>": [ms verifying 1 draft, 2 drafts, ...]} replaces the table;
+                             measure it with tools/tune/bench_step.py and a fixed schedule
+"""
+import json
+import os
+
+# ms per decode step on 2x RTX 3090 (TP2 over NVLink, 7 tokens drafted) verifying 1..7 of them, by batch size.
+DEFAULT_STEP_MS = {1: [10.05, 10.75, 11.25, 11.75, 12.22, 12.60, 13.00]}
+
+
+class AdaptiveDraftLength:
+    """Two running estimates: `first`, how often the first draft is accepted, and `cont`, how often a draft is
+    accepted given the one before it was. The drafter's continuation rate is about the same at every position
+    (0.5-0.8 on the workloads measured), so survival to position i is first * cont**(i-1). Both are observed
+    whenever at least two drafts are verified, however short the verified prefix, so shortening the draft does
+    not starve the estimate of the positions it stopped verifying."""
+
+    def __init__(self, k_max: int, step_ms: dict[int, list[float]], beta: float = 0.03, explore_every: int = 32):
+        self.k_max = k_max
+        self.step_ms = step_ms
+        self.beta = beta
+        self.explore_every = explore_every
+        self.first, self.cont = 0.8, 0.8      # optimistic: a new server starts at the full length
+        self.steps = 0
+
+    def observe(self, num_verified: int, num_accepted: int) -> None:
+        """One request's verify step: `num_verified` drafts were checked and the first `num_accepted` kept."""
+        if num_verified <= 0:
+            return
+        self.first += self.beta * ((1.0 if num_accepted >= 1 else 0.0) - self.first)
+        # continuation trials: positions 2..min(num_accepted + 1, num_verified); all but the last succeeded
+        trials = min(num_accepted + 1, num_verified) - 1
+        if num_accepted >= 1 and trials > 0:
+            wins = min(num_accepted, num_verified) - 1
+            w = 1.0 - (1.0 - self.beta) ** trials
+            self.cont += w * (wins / trials - self.cont)
+
+    def choose(self, batch_size: int, k_cap: int) -> int:
+        """Drafts to verify next step, at most `k_cap` (what the configuration would verify)."""
+        cost = self.step_ms.get(batch_size)
+        if cost is None or k_cap <= 2:
+            return k_cap
+        self.steps += 1
+        if self.steps % self.explore_every == 0:
+            return k_cap
+        best_k, best_rate, tokens, survive = 2, 0.0, 1.0, 1.0
+        for k in range(1, min(k_cap, len(cost)) + 1):
+            survive *= self.first if k == 1 else self.cont
+            tokens += survive
+            rate = tokens / cost[k - 1]
+            if k >= 2 and rate > best_rate * 1.002:      # never below 2: the second draft measures `cont`
+                best_k, best_rate = k, rate
+        return best_k
+
+
+def maybe_adaptive_draft_length(speculative_config, num_spec_tokens: int) -> AdaptiveDraftLength | None:
+    tune = os.environ.get("INKLING_SM86_TUNE", "all")
+    if speculative_config is None or num_spec_tokens <= 1 or not (tune == "all" or "adaptive" in tune.split(",")):
+        return None
+    if getattr(speculative_config, "method", None) != "dspark":
+        return None
+    table = json.loads(os.environ.get("INKLING_SM86_STEP_MS") or "null") or DEFAULT_STEP_MS
+    step_ms = {int(b): [float(v) for v in ms] for b, ms in table.items()}
+    return AdaptiveDraftLength(num_spec_tokens, step_ms)
