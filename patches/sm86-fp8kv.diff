--- a/vllm/models/inkling2/nvidia/ops/nvfp4.py
+++ b/vllm/models/inkling2/nvidia/ops/nvfp4.py
@@ -285,3 +285,33 @@
         launch_pdl=True,
     )
     return values, scales, amax
+
