+@triton.jit
+def _e4m3(x):
+    """The E4M3 byte (sign in bit 7) of fp32 `x`, rounded to nearest even and
+    saturated at 448, and its value: the software form of
+    `cvt.rn.satfinite.e4m3x2.f32`, which sm_8x has no instruction for.
+
+    `x` in `[2**e, 2**(e+1))` rounds to a multiple of `2**(e-3)` (of `2**-9`
+    below `2**-6`, the smallest normal), so the E4M3 grid is the integer grid
+    of `x / 2**max(e - 3, -9)`."""
+    a = tl.minimum(tl.abs(x), 448.0)
+    exponent = (a.to(tl.int32, bitcast=True) >> 23) - 127
+    quantum = tl.maximum(exponent - 3, -9)
+    unit = ((quantum + 127) << 23).to(tl.float32, bitcast=True)
+    scaled = a / unit
+    # Round to nearest even through the fp32 mantissa (|scaled| < 16).
+    scaled = (scaled + 12582912.0) - 12582912.0
+    # Codes 1..7 of the subnormal range, else 8 + mantissa at exponent byte
+    # `quantum + 10`; added, not or-ed, so that a mantissa of 8 carries into
+    # the next exponent.
+    normal = (quantum > -9) | (scaled >= 8.0)
+    code = tl.where(
+        normal,
+        ((quantum + 10) << 3) + (scaled.to(tl.int32) - 8),
+        scaled.to(tl.int32),
+    )
+    sign = x.to(tl.int32, bitcast=True) >> 31
+    value = scaled * unit
+    return (code | (sign << 7)).to(tl.uint8), tl.where(sign != 0, -value, value)
